# Copie este arquivo para `.env` e preencha os valores reais.
# NUNCA versione o `.env` com segredos reais.

# Chave usada para assinar os tokens JWT
SECRET_KEY = troque-por-uma-chave-aleatoria-longa

# Algoritmo de assinatura dos tokens
HASH = HS256

# Duração dos tokens (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES = 30
REFRESH_TOKEN_EXPIRE_MINUTES = 1080

# Chave de API (ex.: usada em integrações externas)
API_KEY = troque-por-sua-chave-de-api

# URL de conexão com o banco de dados.
#
# - Dentro do Docker (API rodando no container): use o host `postgres`,
#   nome do serviço na rede interna do docker-compose.
# - Localmente (Alembic/DBeaver na sua máquina): use `localhost:5433`
#   e sobrescreva a variável no comando (ver README, seção Migrations).
DATABASE_URL = postgresql+psycopg2://USUARIO:SENHA@postgres:5432/encurtador

# Configuração do Postgres (usada pelo docker-compose)
POSTGRES_DB = encurtador
POSTGRES_USER = USUARIO
POSTGRES_PASSWORD = SENHA

# Origens permitidas em CORS, separadas por vírgula (ex.: https://meusite.com)
CORS_ORIGINS = http://localhost:5173,http://127.0.0.1:5173

# URL pública da API, usada no campo "servers" dos docs do OpenAPI
API_BASE_URL = http://localhost:8000
